modules = ["python-3.12", "java-graalvm22.3", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Restaurant Copilot"

[[workflows.workflow]]
name = "Restaurant Copilot"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd restaurant-app && flutter pub get && flutter build web --release --no-pub --pwa-strategy=none && python3 spa_server.py 5000 build/web"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
