modules = ["nodejs-20", "java-graalvm22.3", "python-base-3.13"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Restaurant Copilot"

[[workflows.workflow]]
name = "Restaurant Copilot"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd restaurant-app && flutter build web --release --no-pub && serve build/web -l 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
